{
  "name": "ecogarden",
  "version": "0.9.0",
  "private": true,
  "description": "生态花园：可离线运行的体素生态游戏（模块化工程，零 npm 运行时依赖）",
  "type": "commonjs",
  "scripts": {
    "dev": "node server.cjs",
    "start": "node server.cjs",
    "build": "node scripts/build.cjs",
    "preview": "node scripts/preview.cjs",
    "test": "node tests/behavior.cjs && node tests/render.cjs && node tests/journey.cjs && node tests/shape.cjs && node tests/flow.cjs && node tests/traits.cjs && node tests/visitors.cjs && node tests/audio.cjs && node tests/habits-undo.cjs",
    "test:ecology": "node tests/ecology.cjs",
    "demo": "node scripts/landscape-demo.cjs",
    "demo:water": "node scripts/water-demo.cjs",
    "format": "prettier --write \"**/*.{js,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs}\""
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "game",
    "ecology",
    "threejs",
    "voxel",
    "offline"
  ],
  "license": "SEE LICENSE IN THIRD-PARTY-NOTICES.txt",
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
